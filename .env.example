# ============================================================
# Fission AI - Environment Configuration Template
# Copy this file to .env and provide your actual API keys.
# DO NOT commit .env with real credentials to version control.
# ============================================================

# Groq API Configuration (Required for content strategy & prompt enhancer)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Name (Default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Cloudflare Workers AI Configuration (10,000 free Neurons/day!)
# Account ID: found in https://dash.cloudflare.com/ (right sidebar or URL)
# API Token: create at https://dash.cloudflare.com/profile/api-tokens with "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Google Gemini API Key (Optional)
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# Hugging Face Token (Optional, for FLUX.1 image generation)
# IMPORTANT: Create a token at https://huggingface.co/settings/tokens
# and enable "Make calls to Inference Providers" permission.
HF_TOKEN=hf_your_huggingface_token_here

# Hugging Face Image Generation Models
DEFAULT_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
FALLBACK_IMAGE_MODELS=black-forest-labs/FLUX.1-dev,stabilityai/stable-diffusion-xl-base-1.0

# Database Configuration (Optional, default: data/fission.db)
DB_PATH=data/fission.db
